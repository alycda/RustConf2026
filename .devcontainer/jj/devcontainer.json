// Copy of ../git/devcontainer.json plus a name, the WORKSHOP_HOME_NIX
// override pointing at ./home.nix (which imports the shared ../home.nix and
// adds jujutsu), and the two jj identity secrets below — those are jj-only, so
// they do not belong in the base copy. devcontainer.json has no "extends" —
// keep the rest in sync by hand.
{
    "name": "FFI playground (jj)",
    "image": "debian:bookworm-slim",
    "mounts": [
        "source=claude-auth,target=/root/.claude,type=volume"
    ],
    "features": {
        "ghcr.io/devcontainers/features/nix:1": {
            "packages": []  // home-manager handles packages
        }
    },
    "secrets": {
        "ANTHROPIC_API_KEY": {
            "description": "Claude session key from Claude Console (for Claude Code CLI)"
        },
        // jj is the one tool here that needs an identity handed to it. VS Code
        // copies the host ~/.gitconfig into the container and forwards the
        // host credential helper and ssh-agent, which is why `git` — and
        // `jj git push`, which spawns `git` for every remote operation — need
        // no setup. But jj reads NEITHER the copied gitconfig nor any of it
        // for authorship: user.name/user.email come from jj's own config only,
        // so an unconfigured container commits with an empty identity.
        //
        // jj reads these two variables natively (cli/src/config.rs,
        // env_overrides_layer), so nothing has to write a config file for
        // them: the prompt is the whole mechanism, exactly like the key above.
        // Leave them blank to work anonymously; ./home.nix drops the empties
        // so a later `jj config set --user` still takes effect.
        "JJ_USER": {
            "description": "jj author name, e.g. Ada Lovelace (sets user.name; blank to skip)"
        },
        "JJ_EMAIL": {
            "description": "jj author email (sets user.email; blank to skip)"
        }
    },
    "containerEnv": {
        "WORKSHOP_HOME_NIX": "${containerWorkspaceFolder}/.devcontainer/jj/home.nix"
    },
    "remoteEnv": {
        // home-manager installs direnv (and hx, just, claude) into the USER
        // nix profile. That only reaches PATH via .bashrc, i.e. interactive
        // shells. VS Code's extension host is not one, so mkhl.direnv reports
        // "direnv: command not found" while the integrated terminal works
        // fine. The nix feature's own profile is already on PATH; this is the
        // separate user profile that home-manager writes to.
        "PATH": "/root/.nix-profile/bin:${containerEnv:PATH}"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "alefragnani.bookmarks",
                "anthropic.claude-code",
                "editorconfig.editorconfig",
                "jjk.jjk",
                "jnoortheen.nix-ide",
                "mk12.better-git-line-blame",
                "mkhl.direnv",
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml",
                "skellock.just",
                "visualjj.visualjj"
            ],
            "settings": {
                "chat.disableAIFeatures": true,
                "editor.wordWrap": "on",
                "git.autofetch": true,
                "git.confirmSync": false,
                "git.enabled": false,
                // "nix.enableLanguageServer": true, Command nil not found in $PATH (because it's installed later by direnv)
                // "nix.serverPath": "rnix-lsp",
                "sourceControl.providers": [
                    "jujutsu"   // keep only the Jujutsu provider
                ],
                "workbench.secondarySideBar.defaultVisibility": "hidden"
            }
        }
    },
    "postCreateCommand": "bash ${containerWorkspaceFolder}/.devcontainer/setup.sh",
    "postStartCommand": "bash ${containerWorkspaceFolder}/.devcontainer/poststart.sh"
}
