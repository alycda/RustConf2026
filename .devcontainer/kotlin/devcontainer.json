// Copy of ../git/devcontainer.json plus a name and the WORKSHOP_HOME_NIX
// override pointing at ./home.nix (which imports the shared ../home.nix and
// adds kotlinc + JDK 17). devcontainer.json has no "extends" — keep in sync
// by hand.
{
    "name": "FFI playground (Kotlin/JNA track)",
    "image": "debian:bookworm-slim",
    "mounts": [
        "source=claude-auth,target=/root/.claude,type=volume"
    ],
    "features": {
        "ghcr.io/devcontainers/features/nix:1": {
            "packages": []  // home-manager handles packages
        }
    },
    "secrets": {
        "ANTHROPIC_API_KEY": {
            "description": "Claude session key from Claude Console (for Claude Code CLI)"
        }
    },
    "containerEnv": {
        "WORKSHOP_HOME_NIX": "${containerWorkspaceFolder}/.devcontainer/kotlin/home.nix"
    },
    "remoteEnv": {
        // home-manager installs direnv (and hx, just, claude) into the USER
        // nix profile. That only reaches PATH via .bashrc, i.e. interactive
        // shells. VS Code's extension host is not one, so mkhl.direnv reports
        // "direnv: command not found" while the integrated terminal works
        // fine. The nix feature's own profile is already on PATH; this is the
        // separate user profile that home-manager writes to.
        "PATH": "/root/.nix-profile/bin:${containerEnv:PATH}"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "alefragnani.bookmarks",
                "anthropic.claude-code",
                "editorconfig.editorconfig",
                "jnoortheen.nix-ide",
                "mk12.better-git-line-blame",
                "mkhl.direnv",
                "tamasfe.even-better-toml",
                "rust-lang.rust-analyzer",
                "skellock.just"
            ],
            "settings": {
                "chat.disableAIFeatures": true,
                "editor.wordWrap": "on",
                "git.autofetch": true,
                "git.confirmSync": false,
                // "nix.enableLanguageServer": true, Command nil not found in $PATH (because it's installed later by direnv)
                // "nix.serverPath": "rnix-lsp",
                "workbench.secondarySideBar.defaultVisibility": "hidden"
            }
        }
    },
    // onCreateCommand, not postCreateCommand: setup.sh runs `home-manager
    // switch`, and a switch walks /root/.nix-profile through an intermediate
    // generation that holds neither cargo nor rustc — the old home-manager
    // path is unlinked before the new one goes in. postCreateCommand runs
    // concurrently with the extension host, so rust-analyzer spawns into that
    // few-second window, gets "No such file or directory" for both binaries,
    // and gives up: it does not re-probe, so days/ stays unloaded until
    // someone restarts the server by hand. onCreateCommand completes before
    // the extension host starts, so nothing is looking when the window opens.
    "onCreateCommand": "bash ${containerWorkspaceFolder}/.devcontainer/setup.sh",
    "postStartCommand": "bash ${containerWorkspaceFolder}/.devcontainer/poststart.sh"
}
