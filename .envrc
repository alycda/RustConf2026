# Flakes when the installation has them, the pinned shell.nix when it does
# not. The Determinate installer the README recommends enables
# `nix-command flakes` by default; the upstream one does not, and an .envrc
# that assumed either would break half the room.
#
# Both branches land on the same pinned nixpkgs — shell.nix reads the
# revision out of flake.lock — so the fallback is a different entry point,
# not a different environment.
#
# WORKSHOP_SHELL picks which shell loads on `cd`. Default is the workshop
# shell: the five required tools, nothing heavier. The C libraries behind the
# days' default-off cargo features are opt-in, and so is a language track:
#
#   WORKSHOP_SHELL=full     every C library the day features link against
#   WORKSHOP_SHELL=python   + python3 with cffi (no venv)
#   WORKSHOP_SHELL=kotlin   + JDK 17 and kotlinc
#   WORKSHOP_SHELL=swift    + the Swift toolchain
#   WORKSHOP_SHELL=dart     + the Dart SDK
#
# Set it in your shell profile, or in a gitignored .envrc.local:
#   echo 'export WORKSHOP_SHELL=kotlin' > .envrc.local && direnv reload
[ -f .envrc.local ] && source_env .envrc.local

shell="${WORKSHOP_SHELL:-default}"

if has nix && nix flake --version >/dev/null 2>&1; then
  use flake ".#${shell}"
else
  # `nix-shell -A <shell>`'s direnv spelling. shell.nix exposes the same
  # attribute names the flake does.
  use nix -A "${shell}"
fi

# shell.nix copies the cheatsheet dirs into the store; without these watches,
# sheet edits and renames leave cheat serving the stale store copy until a
# manual reload
watch_dir .cheat
watch_dir .devcontainer/jj/cheat

# Re-enter when the pin or the shell definitions move, so `nix flake update`
# is picked up without a manual `direnv reload`.
watch_file flake.lock
watch_file nix/shells.nix
