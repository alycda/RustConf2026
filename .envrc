# The workshop shell: the five required tools, nothing heavier. The C
# libraries behind the days' default-off cargo features are opt-in — swap
# this for `use nix --arg full true` if you want them loaded on `cd`.
use nix
# `use nix` reloads on shell.nix changes but knows nothing about the lock
# that shell.nix now reads its nixpkgs from; without this a `nix flake
# update` leaves direnv serving the old toolchain until shell.nix itself
# changes.
watch_file flake.lock
# shell.nix copies the cheatsheet dirs into the store; without these watches,
# sheet edits and renames leave cheat serving the stale store copy until a
# manual reload
watch_dir .cheat
watch_dir .devcontainer/jj/cheat
