# Quota system
.quota.group
.quota.user
.quota.ops.group
.quota.ops.user

# TimeMachine
Backups.backupdb
.MobileBackups
.MobileBackups.trash
MobileBackups.trash
tmbootpicker.efi

# Source: https://github.com/github/gitignore/blob/main/Global/Linux.gitignore
# Pulled: 2026-08-08
*~

# temporary files which can be created if a process still has a handle open of a deleted file
.fuse_hidden*

# Metadata left by Dolphin file manager, which comes with KDE Plasma
.directory

# Linux trash folder which might appear on any partition or disk
.Trash-*

# .nfs files are created when an open file is removed but is still being accessed
.nfs*

# Log files created by default by the nohup command
nohup.out

# Source: https://github.com/github/gitignore/blob/main/Global/Windows.gitignore
# Pulled: 2026-08-08
# Windows thumbnail cache files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Dump file
*.stackdump

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# Windows shortcuts
*.lnk

# Attendee puzzle inputs. There is one inputs/ folder now, at the repo root:
# every day binary anchors its path to <repo>/inputs/<YYYY-MM-DD>.txt, and the
# exercise crates will read the same place. AoC asks that real inputs never be
# republished, and in a jj repo an untracked file is auto-snapshotted on the
# next command, so the net is deliberately wide — **/inputs/* also catches a
# stray inputs/ left anywhere else in the tree. Ignore the contents but keep
# the root directory itself: git cannot re-include a file whose parent
# directory is excluded, so this excludes the contents rather than the
# directory, which is what lets the .gitkeep negation take effect.
**/inputs/*
!/inputs/.gitkeep
# The Bazel overlay's filegroup lives here too, and is source, not an input.
# Same negation mechanism as .gitkeep above, and it works for the same
# reason: the rule excludes the contents, not the directory.
!/inputs/BUILD.bazel

# cbindgen-generated headers of the day crates — regenerate with
# `just days bindgen <day>`; cbindgen is required workshop tooling, so this
# is machine output, not source, same reasoning as **/uniffi/bindings/
# below. Scoped to days/*/include/ on purpose (it lived in days/.gitignore
# until that file went with days/inputs/): a hand-written header under some
# other include/ must stay tracked, and jj never warns about an ignored file.
# Exercise 2's own generated header is scoped the same way in
# exercises/.gitignore.
/days/*/include/*.h

# Per-attendee direnv override, sourced by .envrc — this is where
# WORKSHOP_SHELL goes, so it must never be committed: which shell you load on
# `cd` is a personal choice, not a repo one.
/.envrc.local

# --- Bazel overlay (docs/bazel-evaluation.md) ---
# Convenience symlinks Bazel drops at the workspace root; the real outputs
# live in the user's Bazel cache. MODULE.bazel.lock and tools/Cargo.lock are
# NOT here on purpose — they are lockfiles and belong in the tree.
/bazel-*

# --- Buck2 overlay (docs/buck2-evaluation.md) ---
# buck-out is buck2's output tree, the peer of bazel-*. third-party/rust's
# BUCK, Cargo.lock and fixups/ are NOT ignored: they are generated but
# committed, and reviewing them in a diff is one of the overlay's arguments.
/buck-out
