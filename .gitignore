# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore automatically generated direnv output
.direnv

# Claude Code writes accepted permission grants here. Its sibling
# .claude/settings.json is tracked (shared config), so the directory is already
# in the repo and this file would otherwise ride along into a repo attendees
# clone.
.claude/settings.local.json

# Python track venv (created by `just setup-python`)
.venv/

# --- Language tracks ---
# All tracks are ignored up front, even though Exercise 3 is pick-one:
# trying another language is an extension exercise, and spare ignore
# rules cost nothing. This is the book's "step zero" principle applied —
# which is why the workshop skips the git step: it's already done here.

# Rust
# Source: https://github.com/github/gitignore/blob/main/Rust.gitignore (trimmed)
# Pulled: 2026-08-08
target/
**/*.rs.bk
*.pdb

# C build artifacts and shared libraries (every track links against these)
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.out

# UniFFI output. The generator writes a whole directory per language, and only
# some of it is caught by the extension rules above — a .py binding and a
# compiled Swift harness have no matching pattern, so without this they get
# committed. Named exactly, not **/bindings/: exercises/ex3-bindings/ is
# hand-written source and must not be swept up by a rule aimed at machine
# output.
**/uniffi/bindings/

# Python (venv above)
# Source: https://github.com/github/gitignore/blob/main/Python.gitignore (trimmed)
# Pulled: 2026-08-08
__pycache__/
*.py[cod]

# Swift
# Source: https://github.com/github/gitignore/blob/main/Swift.gitignore (trimmed)
# Pulled: 2026-08-08
.build/
DerivedData/

# Kotlin/JNA (*.jar is ignored as a build output; vendor deps would need an exception)
# Source: https://github.com/github/gitignore/blob/main/Kotlin.gitignore (trimmed)
# Pulled: 2026-08-08
*.class
*.jar
.gradle/
build/

