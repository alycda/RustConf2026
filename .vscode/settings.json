{
  // The extension host inherits none of direnv's env — its PATH is the nix
  // profile plus the system dirs — so rust-analyzer starts with no cargo or
  // rustc and stays broken until something restarts it. mkhl.direnv (see
  // extensions.json) does that itself with this set. It lives here rather
  // than in the devcontainer.json files so attendees running VS Code against
  // a local nix-shell get it too, not just the container ones.
  "direnv.restart.automatic": true,

  // This repo holds TWO cargo workspaces, and rust-analyzer finds only one of
  // them on its own: it auto-discovers manifests at the workspace root and
  // one level below, so days/Cargo.toml is found and the exercise crates —
  // exercises/ex1-pure-rust/Cargo.toml, two levels down — are not. Without
  // this, every file the attendee actually edits opens with no completion and
  // no go-to-definition, and saving one logs "file not found" in the RA log.
  //
  // Both roots are named because linkedProjects REPLACES auto-discovery
  // rather than adding to it: listing only exercises/ would lose days/.
  //
  // This sits with the exercises rather than on main because a linkedProjects
  // entry pointing at a manifest that does not exist is itself an RA load
  // error — the list has to arrive with the workspace it names.
  "rust-analyzer.linkedProjects": [
    "days/Cargo.toml",
    "exercises/Cargo.toml"
  ],

  // Format Rust on save, so the CI fmt gate never rejects a file the editor
  // could have fixed. Not a nicety: the failure it prevents is invisible to
  // read. The first one was a 61-character method chain against rustfmt's
  // default chain_width of 60 — on a 69-character line, well inside
  // max_width, so it looked correct to every human who saw it.
  //
  // Scoped to [rust], NOT set globally, because this repo carries eight
  // toolchains and an attendee installs exactly one. A global formatOnSave
  // would fire on Python/Kotlin/Swift/Dart/C files against whatever formatter
  // that attendee happens to have — nagging them about missing extensions at
  // best, reformatting a track they never opted into at worst.
  //
  // defaultFormatter is spelled out because "format on save" with more than
  // one capable extension installed is a picker prompt, not a format.
  "[rust]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },

  // VS Code's Explorer and search already read .gitignore
  // (search.useIgnoreFiles is on by default), so this file carries only the
  // things .gitignore cannot cover.

  // .jj is not gitignored — it is the repository itself, not build output.
  // VS Code hides .git by default but knows nothing about .jj.
  "files.exclude": {
    // --- VCS -------------------------------------------------------------
    // Colocated jj + git. **/.git is excluded by VS Code's defaults already.
    "**/.jj": true,
 
    // --- Nix -------------------------------------------------------------
    "result": true,
    "result-*": true,
    "**/.direnv": true,

    // --- Python venv ---------------------------------------------------------
    "**/.venv": true,

    // --- Rust ----------------------------------------------------------------
    // Hidden from the Explorer only; rust-analyzer is unaffected by this.
    "**/target": true,
    "**/*.rs.bk": true,
    "**/*.pdb": true,

    // --- C -------------------------------------------------------------------
    // Object files and static archives only. Shared libraries (.so/.dylib/
    // .dll) stay VISIBLE on purpose: watching the cdylib appear is the point
    // of the workshop. They are kept out of search results instead.
    "**/*.o": true,
    "**/*.obj": true,
    "**/*.a": true,
    "**/*.lib": true,

    // --- Python bytecode -----------------------------------------------------
    "**/__pycache__": true,
    "**/*.py[cod]": true,

    // --- Swift ---------------------------------------------------------------
    "**/.build": true,
    "**/DerivedData": true,

    // --- Kotlin / Gradle -----------------------------------------------------
    "**/*.class": true,
    "**/*.jar": true,
    "**/.gradle": true,
    "**/build": true,

    // --- Flutter / Dart ------------------------------------------------------
    "**/.dart_tool": true,

    // --- OS ------------------------------------------------------------------
    "**/.DS_Store": true,

    // --- Docs ----------------------------------------------------------------
    // book/ is the mdBook project; book/book is what `mdbook build` renders.
    "book/book": true,

    // --- No .gitignore counterpart -------------------------------------------
    // Editor-only noise reduction: nothing here is build output this repo
    // ignores, so these arrive together rather than on a ladder rung.
    "**/.flutter-plugins": true,
    "**/.flutter-plugins-dependencies": true,
    "**/ios/Pods": true,
    "**/ios/.symlinks": true,
    "**/linux/flutter/ephemeral": true,
    "**/macos/Flutter/ephemeral": true,
    "**/windows/flutter/ephemeral": true,
    "**/node_modules": true
  },

  // Adds to files.exclude — everything above is already out of search.
  "search.exclude": {
    "**/*.so": true,
    "**/*.so.*": true,
    "**/*.dylib": true,
    "**/*.dll": true,
    "**/*.out": true,

    // Lockfiles and wrappers: keep them tracked and openable, out of grep.
    "**/Cargo.lock": true,
    "**/pubspec.lock": true,
    "**/Package.resolved": true,
    "**/gradle/wrapper/**": true
  },

  // The file watcher does NOT read .gitignore, so these must be spelled out
  // even though .gitignore already lists them. jj re-snapshots the working
  // copy on every command, which makes .jj/** the exclusion that pays for
  // itself immediately.
  "files.watcherExclude": {
    "**/.jj/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/result/**": true,
    "**/.direnv/**": true,
    "**/.venv/**": true,
    "**/target/**": true,
    "**/__pycache__/**": true,
    "**/.build/**": true,
    "**/DerivedData/**": true,
    "**/.gradle/**": true,
    "**/build/**": true,
    "**/.dart_tool/**": true,
    "**/book/book/**": true,
    "**/ios/Pods/**": true,
    "**/node_modules/**": true
  }
}
