# Real puzzle inputs, whatever they were saved as — only the tracked
# .gitkeep keeps the directory present.
**/inputs/*
!**/inputs/.gitkeep

# cbindgen-generated headers (Exercise 2) — regenerate with
# `just days bindgen <day>`; cbindgen is required workshop tooling, so this
# is machine output, not source, same reasoning as **/uniffi/bindings/ in
# the repo-root .gitignore.
**/include/*.h
