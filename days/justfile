# Not all of CI: the workflow also checks the workspace against rustc 1.85,
# which needs a second toolchain installed, so this can pass while CI fails on
# the floor. The recipes below take one day; this never does, because
# `members = ["*"]` means a change to a shared dep breaks days you didn't touch.

# every day at once: the three gates rust.yml runs on every push — run before pushing
verify:
    cargo test --workspace --locked
    cargo fmt --all --check
    cargo clippy --workspace --all-targets --locked -- -D warnings

check day:
    cd {{day}} && cargo check

test day:
    cd {{day}} && cargo test

run day:
    cd {{day}} && cargo run

# criterion benchmarks, where a day has them — a bonus, and not every day
# carries one. `cargo test` skips bench targets, so what keeps these from
# rotting is the clippy gate in `verify`: --all-targets compiles and lints a
# bench without running it. Timings only ever come from here.
#
# criterion's own flags go on the end — `just days bench 2023-12-01
# --save-baseline pure-rust`, then `--baseline pure-rust` to compare a later
# run against it. `--bench day` is what lets them through: it skips the
# libtest bench targets cargo generates for the lib and the bin, which
# reject any flag they do not recognise.
#
# `--bench day` is also the reason this recipe takes no --features: a day
# whose second bench races a C library against plain Rust declares
# required-features on that target, and cargo skips it here rather than
# failing. Run those directly, e.g.
# `cargo bench -p aoc-<day> --bench <subject> --features <lib>`.
bench day *args:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f "{{day}}/benches/day.rs" ]; then
        echo "days/{{day}} has no benchmark — not every day carries one" >&2
        exit 1
    fi
    cd "{{day}}" && cargo bench --bench day -- {{args}}

# cbindgen header for a day's C-callable surface (Exercise 2), where a day
# has one — a bonus, and not every day carries one. Not committed (see
# .gitignore): cbindgen is required workshop tooling, so this is
# always a `just` call away instead of a file to keep in sync by hand.
# Exercise 3 tracks regenerate it the same way before building against it.
bindgen day:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f "{{day}}/cbindgen.toml" ]; then
        echo "days/{{day}} has no cbindgen.toml — not every day carries a C API." >&2
        echo "To give it one (Exercise 2's shape): copy days/2023-12-01/cbindgen.toml," >&2
        echo "add a src/c_api.rs, and set crate-type = [\"rlib\", \"cdylib\"] in Cargo.toml." >&2
        exit 1
    fi
    ident="$(printf '%s' "{{day}}" | tr - _)"
    cd "{{day}}"
    mkdir -p include
    # src/c_api.rs, not the crate dir: a day that also *imports* a C library
    # keeps those `extern "C"` declarations in their own module, and cbindgen
    # pointed at the crate root would walk them too and redeclare somebody
    # else's API inside our header. Aiming it at the one file that defines
    # the export surface is what keeps the header to this day's own
    # functions — including on days that have no such module yet.
    cbindgen --config cbindgen.toml --output "include/aoc_${ident}.h" src/c_api.rs
    echo "wrote {{day}}/include/aoc_${ident}.h"

# Exercise 3 (Python/cffi track): call a day's cbindgen C API from Python.
# `just setup-python` once (repo-local .venv) first. Depends on `bindgen`
# rather than duplicating its cbindgen invocation — same bonus convention
# as `bench`/`bindgen` otherwise.
python-demo day: (bindgen day)
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f "{{day}}/python/solve.py" ]; then
        echo "days/{{day}} has no python/solve.py — not every day carries one" >&2
        exit 1
    fi
    cd "{{day}}" && cargo build --lib
    cd ..
    # scripts/venv-python.sh owns the venv-vs-python3 rule (shared with
    # self-check, the exercises justfile and CI).
    py="$(../scripts/venv-python.sh)"
    "$py" "{{day}}/python/solve.py"


# Exercise 3 (Dart/dart:ffi track): call a day's cbindgen C API from Dart.
# `just setup-dart` once first. Depends on `bindgen` rather than
# duplicating its cbindgen invocation — the header isn't actually parsed
# (dart:ffi needs signatures written as Dart types, see the day's
# dart/solve.dart), but regenerating it keeps it available for eyeballing
# alongside the hand-transcribed ones.
dart-demo day: (bindgen day)
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f "{{day}}/dart/solve.dart" ]; then
        echo "days/{{day}} has no dart/solve.dart — not every day carries one" >&2
        exit 1
    fi
    cd "{{day}}" && cargo build --lib
    cd dart
    dart pub get
    dart run solve.dart



# Exercise 3 (Kotlin/JNA track): call a day's cbindgen C API from Kotlin.
# `just setup-kotlin` once first (JDK 17+ and kotlinc — what `just check`
# probes). Depends on `bindgen` rather than duplicating its cbindgen
# invocation — the header isn't actually parsed (JNA needs the signatures
# written as Kotlin methods, see the day's kotlin/solve.kt), but
# regenerating it keeps it available for eyeballing alongside the
# hand-transcribed ones.
#
# JNA is the track's one dependency and there is no `pip`/`dart pub` here to
# fetch it, so it comes straight from Maven Central — pinned and checksummed,
# because an unpinned jar downloaded over the network and then executed is a
# different kind of thing from a pinned one. Cached next to the script after
# the first run; *.jar is gitignored repo-wide.
kotlin-demo day: (bindgen day)
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f "{{day}}/kotlin/solve.kt" ]; then
        echo "days/{{day}} has no kotlin/solve.kt — not every day carries one" >&2
        exit 1
    fi
    # The pin, the hash, the cache and the checksum tool all live in
    # scripts/fetch-jna.sh, shared with the exercises and CI; it honours the
    # JNA_JAR the kotlin devcontainer exports and prints the jar's path.
    jna="$(../scripts/fetch-jna.sh)"
    cd "{{day}}" && cargo build --lib
    cd kotlin
    # -include-runtime bundles the Kotlin stdlib, so the result runs under
    # plain `java` — which is exactly what scripts/self-check.sh guarantees
    # for this track (kotlinc + a runnable java, nothing else).
    kotlinc solve.kt -classpath "$jna" -include-runtime -d solve.jar
    # ':' everywhere but Windows, where the JVM splits a classpath on ';'.
    # cygpath is the tell that this is Git Bash driving a native Windows java
    # — the same tell scripts/fetch-jna.sh uses to hand back a path it can open.
    cp_sep=:
    command -v cygpath >/dev/null 2>&1 && cp_sep=';'
    java -cp "solve.jar${cp_sep}$jna" SolveKt


# Exercise 3 (Swift track): call a day's cbindgen C API from Swift.
# `just setup-swift` once first (the Xcode CLT on macOS, swift.org on Linux —
# what `just check` probes). Depends on `bindgen` rather than duplicating its
# cbindgen invocation, and here the dependency is real: swift/module.modulemap
# names the generated header, and clang has to be able to open it before
# `import AocDay` means anything.
#
# No package manager, no jar to fetch, nothing pinned — the C API arrives
# through the header, which is the point of this track.
#
# The two -L/-rpath pairs are the compiled-language shape of what the other
# three tracks do at runtime: python/dart/kotlin `dlopen` a path they compute
# by looking for debug then release, and Swift asks the linker instead. Both
# are passed unconditionally; a directory that doesn't exist costs nothing,
# and debug comes first for the same reason it does in those scripts. -rpath
# takes absolute paths on purpose — the portable spelling of "next to me"
# differs between platforms ($ORIGIN vs @loader_path) and this is a
# development recipe, not something being shipped anywhere.
swift-demo day: (bindgen day)
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f "{{day}}/swift/solve.swift" ]; then
        echo "days/{{day}} has no swift/solve.swift — not every day carries one" >&2
        exit 1
    fi
    cd "{{day}}" && cargo build --lib
    target="$(cd ../target && pwd)"
    cd swift
    # .build/ is Swift's own name for build output and is already ignored
    # repo-wide; a bare `solve` beside solve.swift matches no rule in either
    # .gitignore and would be committed. solve.swift locates itself relative
    # to the executable, so it knows to look one level further up.
    mkdir -p .build
    # Where Foundation lives, when it does not live with the compiler.
    #
    # `solve.swift` imports Foundation, and on macOS or a swift.org toolchain
    # that needs no flags at all — Foundation ships with Swift. In the
    # repo's Swift devcontainer it does not: nixpkgs packages corelibs
    # separately, home-manager installs them into the *user profile*, and
    # `swiftc` searches only its own toolchain path. Bare, it fails with
    # `no such module 'Foundation'`.
    #
    # Three directories, because one package spreads across three and the
    # error message names the same module every time (the failure ladder is
    # written up in .devcontainer/swift/README.md):
    #   lib/swift/linux/<arch>  the Swift modules  (-I)      "no such module"
    #   include                 the clang module maps (-Xcc) "missing required
    #                                                         modules"
    #   lib/swift/linux         libFoundation.so   (-L)      "cannot find -lFoundation"
    #   lib                     libdispatch.so etc (-L)
    #
    # Added only when that layout is actually present, so a nix-shell (whose
    # setup hooks already put corelibs on the search path) and a Mac are both
    # unaffected. If this rots, the devcontainer README's own advice is the
    # sturdier route: build through nixpkgs' Swift stdenv adapter or swiftpm,
    # which wire these paths themselves rather than having a caller name them.
    # The -rpath pair is not redundant with the -L pair, and finding that out
    # cost a second debugging round. Built *outside* a nix-shell, the linker
    # promotes these -L directories to RUNPATH by itself and the binary runs.
    # Built inside one — which is how this recipe always runs — it does not:
    # the profile paths are symlink farms rather than store paths, they are
    # dropped from RUNPATH, and the binary links clean and then dies at
    # startup with `libBlocksRuntime.so: cannot open shared object file`.
    # Compiling, linking and *loading* are three separate searches; -L answers
    # the second and only -rpath answers the third.
    # The flags themselves live in scripts/swift-corelibs-flags.sh, shared
    # with the exercises justfile and CI; it prints nothing where the layout
    # above is absent.
    swiftc solve.swift -o .build/solve \
        -I . \
        $(../../../scripts/swift-corelibs-flags.sh) \
        -L "$target/debug" -L "$target/release" \
        -l"aoc_$(printf '%s' "{{day}}" | tr - _)" \
        -Xlinker -rpath -Xlinker "$target/debug" \
        -Xlinker -rpath -Xlinker "$target/release"
    ./.build/solve

# Exercise 3 (Godot/GDExtension track): call a day's Rust from GDScript.
# `just setup-godot` once first (what `just check` probes).
#
# No `(bindgen day)` dependency, and this is the first track without one.
# The other four consume the cbindgen header — python and swift parse it,
# dart and kotlin keep it beside their hand-transcriptions — but a
# GDExtension reads no header in either direction. The engine hands the
# library a get_proc_address at load and the library asks for every engine
# function by name; the library hands back its classes the same way. The
# only static contract is godot/aoc.gdextension, which is not generated by
# anything.
#
# --features godot, because the gdext crate declares rust-version 1.94 and
# the workspace floor is 1.85 — see the day's Cargo.toml. First build is
# minutes: gdext generates bindings for the whole engine API from a JSON
# file it ships. Later ones are seconds.
godot-demo day:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f "{{day}}/godot/test.gd" ]; then
        echo "days/{{day}} has no godot/test.gd — not every day carries one" >&2
        exit 1
    fi
    # scripts/godot-bin.sh owns the godot-vs-godot4 rule (shared with
    # self-check); it honours $GODOT for an official download off PATH.
    if ! godot="$(../scripts/godot-bin.sh)"; then
        echo "no Godot 4 binary found — run: just setup-godot" >&2
        exit 1
    fi
    lib="aoc_$(printf '%s' "{{day}}" | tr - _)"
    cd "{{day}}" && cargo build --lib --features godot
    # res:// is rooted at the project directory and the engine will not walk
    # out of it, so the descriptor cannot name ../../target/debug — the
    # cdylib comes to it. Three filenames for one library, the same three
    # python/solve.py searches at runtime: whichever cargo produced is the
    # one that exists. godot/lib/ is gitignored by the repo-wide *.so,
    # *.dylib and *.dll rules.
    mkdir -p godot/lib
    found=
    for name in "lib${lib}.so" "lib${lib}.dylib" "${lib}.dll"; do
        if [ -f "../target/debug/$name" ]; then
            cp "../target/debug/$name" "godot/lib/$name"
            found="$name"
        fi
    done
    if [ -z "$found" ]; then
        echo "cargo built no cdylib for {{day}} — is crate-type = [\"rlib\", \"cdylib\"] set?" >&2
        exit 1
    fi
    cd godot
    # The import scan, every time. The engine finds .gdextension files while
    # scanning the project and records them in .godot/extension_list.cfg; on
    # a tree that has never been scanned (a fresh clone, a CI runner) the
    # script below starts, loads no extension, and fails with "Identifier
    # Aoc20151201 not declared" — a message about the script rather than
    # about the library it was never told to load.
    #
    # `|| true`, and then check the artifact instead. The *first* --import on
    # a project with no .godot/ does all its work and then aborts on the way
    # out (SIGABRT, exit 134, after "EditorSettings: Save OK!"); the second
    # and every later one exits 0. Observed on 4.7.2, headless, Linux. Since
    # what this step is for is a file, the file is what to test — and the run
    # that actually matters, the one below, reports its own exit code
    # honestly.
    "$godot" --headless --import || true
    if [ ! -f .godot/extension_list.cfg ]; then
        echo "godot --import produced no .godot/extension_list.cfg — the extension will not load" >&2
        exit 1
    fi
    # test.gd is both the test and the demo: it asserts the statement
    # examples, then prints this day's answers if you have dropped an input
    # at <repo>/inputs/{{day}}.txt.
    "$godot" --headless -s test.gd

# scaffold a new day from _template, e.g. `just new 2022-12-01`
new day:
    #!/usr/bin/env bash
    set -euo pipefail
    # Bare YYYY-MM-DD only: {{day}} lands in paths, a sed expression, and a
    # crate name, so anything else (a trailing slash, say) dies mid-scaffold
    # and leaves a half-renamed crate that breaks the whole workspace.
    if [[ ! "{{day}}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        echo "day must be YYYY-MM-DD (e.g. 2022-12-01), got '{{day}}'" >&2
        exit 1
    fi
    if [ -e "{{day}}" ]; then
        echo "days/{{day}} already exists" >&2
        exit 1
    fi
    cp -R _template "{{day}}"
    rm -rf "{{day}}/target"
    ident="$(printf '%s' "{{day}}" | tr - _)"
    # `sed -i` takes an argument on BSD but not GNU, so write via a temp file
    find "{{day}}" -type f \( -name '*.rs' -o -name '*.toml' \) | while read -r f; do
        sed -e "s/day-template/{{day}}/g" -e "s/day_template/${ident}/g" "$f" > "$f.new"
        mv "$f.new" "$f"
    done
    # The new member has to appear in days/Cargo.lock before anything runs
    # --locked, which verify and CI both do. Without this the first command
    # after scaffolding fails on the lockfile rather than on the puzzle.
    # `cargo metadata` is the cheapest thing that resolves the workspace.
    cargo metadata --format-version 1 >/dev/null
    echo "created days/{{day}} — now: just test {{day}} (and commit Cargo.lock)"
