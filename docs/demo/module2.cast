[2.356, "o", "\u001b[1;32m$\u001b[0m cat include/ex2_c_glue.h\r\n"]
[0.907, "o", "#ifndef EX2_C_GLUE_H\r\n#define EX2_C_GLUE_H\r\n\r\n/* Auto-generated by cbindgen — run `cbindgen --output include/ex2_c_glue.h` to regenerate. */\r\n\r\n#include <stdarg.h>\r\n#include <stdbool.h>\r\n#include <stdint.h>\r\n#include <stdlib.h>\r\n\r\n/**\r\n * Error convention: return -1 when the input is null or not valid UTF-8.\r\n * In-band errors are the simplest possible convention — Module 4 discusses\r\n * what production code does instead (out-params, error codes, last-error).\r\n */\r\n#define INVALID_INPUT -1\r\n\r\n/**\r\n * # Safety\r\n * `input` must be a valid NUL-terminated C string or null.\r\n */\r\nint64_t ex_part1(const char *input);\r\n\r\n/**\r\n * # Safety\r\n * `input` must be a valid NUL-terminated C string or null.\r\n */\r\nint64_t ex_part2(const char *input);\r\n\r\n#endif  /* EX2_C_GLUE_H */\r\n"]
[1.405, "o", "\r\n\u001b[2m# compile the C caller against it\u001b[0m\r\n"]
