[1.405, "o", "\r\n\u001b[2m# a panic across extern \"C\" aborts the process. No return value, no stack trace for the caller.\u001b[0m\r\n"]
[1.211, "o", "\r\n\u001b[2m# now the four steps: null check → CStr → UTF-8 → the solver\u001b[0m\r\n"]
[1.232, "o", "\u001b[1;32m$\u001b[0m sed -n \"/^pub unsafe extern \\\"C\\\" fn ex_part1/,/^}/p\" src/lib.rs\r\n"]
[0.906, "o", "pub unsafe extern \"C\" fn ex_part1(input: *const c_char) -> i64 {\r\n    if input.is_null() {\r\n        return INVALID_INPUT; // 1. never deref a null\r\n    }\r\n    let cstr = unsafe { CStr::from_ptr(input) }; // 2. the pointer contract, asserted\r\n    let Ok(s) = cstr.to_str() else {\r\n        return INVALID_INPUT; // 3. C strings promise nothing about UTF-8\r\n    };\r\n    ex1_pure_rust::part1(s) // 4. the pure solver, untouched\r\n"]
[0.000, "o", "}\r\n"]
