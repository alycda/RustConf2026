# vhs tape for the Module 2 demo — a gif of docs/demo/module2.sh.
# Run on a machine where vhs can drive a browser (a Mac, not the root
# devcontainer), from the workshop nix shell, in the repo root:
#   vhs docs/demo/module2.tape
Output docs/demo/module2.gif
Set Shell bash
Set FontSize 22
Set Width 1400
Set Height 900
Set Theme "Catppuccin Mocha"
Set TypingSpeed 40ms
Hide
Type "clear" Enter
Show
Type "docs/demo/module2.sh /tmp/rustconf-demo" Enter
Sleep 45s
