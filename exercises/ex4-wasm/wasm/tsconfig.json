{
  "compilerOptions": {
    "target": "ES2022",
    // DOM for one name: `WebAssembly` is declared in lib.dom, not in
    // @types/node, even though Node has had it since v8.
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],

    // Effect's error channel is a type. Without `strict` it degrades to
    // `any`, and TODO 5 is about the compiler knowing which failure is which.
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
